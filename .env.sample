# ============================================================
# Variables d'environnement / GitHub Secrets nécessaires
# pour exécuter le workflow deploy.yml de zéro
# ============================================================

# --- AWS Credentials ---
# Clés d'accès IAM pour provisionner l'infrastructure EC2
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# --- Registre Docker Privé ---
# IP publique de l'EC2 hébergeant le registre Docker
REGISTRY_IP=35.180.174.97
# Identifiants de connexion au registre Docker
REGISTRY_USER=admin
REGISTRY_PASSWORD=admin123

# --- Base de données MySQL ---
# Mot de passe root utilisé par la stack applicative
MYSQL_ROOT_PASSWORD=your_mysql_root_password

# ============================================================
# Comment configurer dans GitHub :
# 1. Aller dans Settings > Secrets and variables > Actions
# 2. Ajouter chaque variable ci-dessus comme "Repository secret"
# 3. Lancer le workflow via Actions > Deploy Full Stack Application > Run workflow
# ============================================================
